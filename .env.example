# Telegram (@BotFather)
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Quote when user sends only base ticker (e.g. /get sol)
DEFAULT_QUOTE=USDT

# CoinMarketCap Pro — contracts + disambiguation (optional)
CMC_API_KEY=

# Exchange API keys — D/W (read-only). OKX: also add bot server IP to API whitelist on okx.com
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
MEXC_API_KEY=
MEXC_API_SECRET=
BINGX_API_KEY=
BINGX_API_SECRET=
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=
# Kraken D/W: enable "Query" + "Deposit" + "Withdraw" under Funds permissions
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

LOG_LEVEL=INFO
HTTP_TIMEOUT=0.40
HTTP_CONNECT_TIMEOUT=0.15
HTTP_MAX_RETRIES=1
REPORT_CACHE_TTL=75
REPORT_CACHE_STALE_TTL=120
FAST_CACHE_TTL=75
FAST_WAIT_MS=280
DW_CACHE_TTL=600

# Vultr Tokyo / Japan proxy — max speed (auto-enables TURBO_MODE)
ASIA_VPS=1
TURBO_MODE=1
ENRICH_SPLIT=1
FIRST_PAINT_MS=220
FIRST_RESPONSE_SEC=0.75
# Optional outbound proxy for exchange APIs (leave empty on direct VPS)
HTTP_PROXY=
